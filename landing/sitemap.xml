<?xml version="1.0" encoding="UTF-8"?>
<!-- Two pages, because there are two: the same content for two readers, at
     two URLs. Each entry declares every alternate including itself, which is
     what the protocol asks for; a one-sided declaration is treated as
     incomplete and ignored.

     The URLs carry no trailing slash. vercel.json sets trailingSlash:false,
     so /en/ would 308 to /en, and an hreflang that points at a redirect is
     a soft error nobody sees until the English page fails to rank.

     Still no anchors. Fragments are not separate documents, and a sitemap
     padded with them reports the same URL several times. -->
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9"
        xmlns:xhtml="http://www.w3.org/1999/xhtml">
  <url>
    <loc>https://tenders-finder.vercel.app/</loc>
    <xhtml:link rel="alternate" hreflang="he" href="https://tenders-finder.vercel.app/"/>
    <xhtml:link rel="alternate" hreflang="en" href="https://tenders-finder.vercel.app/en"/>
    <xhtml:link rel="alternate" hreflang="x-default" href="https://tenders-finder.vercel.app/"/>
    <lastmod>2026-09-14</lastmod>
    <changefreq>monthly</changefreq>
    <priority>1.0</priority>
  </url>
  <url>
    <loc>https://tenders-finder.vercel.app/en</loc>
    <xhtml:link rel="alternate" hreflang="he" href="https://tenders-finder.vercel.app/"/>
    <xhtml:link rel="alternate" hreflang="en" href="https://tenders-finder.vercel.app/en"/>
    <xhtml:link rel="alternate" hreflang="x-default" href="https://tenders-finder.vercel.app/"/>
    <lastmod>2026-09-14</lastmod>
    <changefreq>monthly</changefreq>
    <priority>0.9</priority>
  </url>
</urlset>
