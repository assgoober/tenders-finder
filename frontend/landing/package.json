{
  "name": "tenders-finder-landing",
  "version": "0.1.0",
  "private": true,
  "description": "Tenders Finder landing page — a single static HTML file, no build step.",
  "type": "module",
  "scripts": {
    "deploy": "vercel deploy --prod",
    "preview": "vercel deploy",
    "stamp": "node tools/stamp-origin.mjs",
    "og": "node tools/build-og.mjs",
    "serve": "python3 -m http.server 4173",
    "stats": "node tools/refresh-stats.mjs",
    "build:en": "node tools/build-en.mjs",
    "check:en": "node tools/build-en.mjs --check"
  },
  "devDependencies": {
    "@supabase/supabase-js": "^2.45.0",
    "cheerio": "^1.2.0",
    "playwright": "^1.49.0"
  }
}
