# Tenders Finder — environment configuration
# Copy to .env and fill in. Never commit the filled-in file.

# --- Anthropic (extraction) -------------------------------------------------
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
ANTHROPIC_MAX_TOKENS=16000
EXTRACTION_TIMEOUT_SECONDS=300

# --- Embeddings -------------------------------------------------------------
# "voyage" for production, "hash" for offline development (no API key needed,
# not semantic — development only).
EMBEDDING_PROVIDER=voyage
VOYAGE_API_KEY=
VOYAGE_MODEL=voyage-3-large
# Must equal the vector(N) in supabase/migrations/0001_extensions.sql.
# Changing it requires a migration plus a full re-embedding (REPOMIX.md ADR-6).
EMBEDDING_DIM=1024

# --- Supabase ---------------------------------------------------------------
SUPABASE_URL=
# Service role key — bypasses RLS. Server-side only, never in the browser.
SUPABASE_SERVICE_ROLE_KEY=

# --- Scraping ---------------------------------------------------------------
SCRAPE_CONCURRENCY=4
SCRAPE_TIMEOUT_SECONDS=60
SCRAPE_MAX_RETRIES=4
SCRAPE_BACKOFF_BASE_SECONDS=2
SCRAPE_BACKOFF_MAX_SECONDS=60
SCRAPE_USER_AGENT=TendersFinderBot/0.1 (+https://tendersfinder.example/bot)
PLAYWRIGHT_HEADLESS=true

# --- Service ----------------------------------------------------------------
LOG_LEVEL=INFO
# Runs the full pipeline without writing to a database.
DRY_RUN=false

# --- Web (Next.js) ----------------------------------------------------------
# Anon key only — the browser operates under RLS as the signed-in user.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
